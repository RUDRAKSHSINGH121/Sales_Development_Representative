# ==============================================================================
# LeadPilot - Docker Compose Environment Configuration (Example Template)
# ==============================================================================

# PostgreSQL Database Configuration
POSTGRES_DB=leadpilot
POSTGRES_USER=leadpilot
POSTGRES_PASSWORD=leadpilot
POSTGRES_HOST_PORT=5433

# Application Ports
BACKEND_PORT=8000
FRONTEND_PORT=3000

# Backend Services & Security
DATABASE_URL=postgresql+psycopg://leadpilot:leadpilot@db:5432/leadpilot
JWT_SECRET_KEY=change-this-to-a-secure-random-secret-key
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# AI Provider Credentials (Objective 4 & Objective 5)
OPENAI_API_KEY=your-openai-api-key
OPENAI_BASE_URL=https://aicredits.in/v1
GEMINI_API_KEY=your-gemini-api-key

# Frontend Configuration
NEXT_PUBLIC_API_URL=http://localhost:8000
